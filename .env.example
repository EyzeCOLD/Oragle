# Copy to .env (gitignored) and fill in. The real environment always wins.

# --- LLM provider: any OpenAI-compatible endpoint ---------------------
# The usual three:
#   MTG_API_BASE=https://openrouter.ai/api/v1
#   MTG_API_KEY=sk-...
#   MTG_MODEL=provider/model-name
# Alternative backends (no MTG_API_BASE needed):
#   MISTRAL_API_KEY=...            # api.mistral.ai
#   MTG_BACKEND=lmstudio           # LM Studio server on localhost:1234
#   MTG_BACKEND=ollama             # Ollama on localhost:11434

# --- optional tuning (defaults shown) ----------------------------------
#   MTG_FALLBACK_MODEL=            # empty = no fallback model
#   MTG_SLOW_AFTER=75              # seconds without answer text (0 = off)
#   MTG_LLM_TIMEOUT=240            # per-request timeout, seconds

# --- web app (only for `oragle serve`) ----------------------------------
#   WEB_TOKEN=pick-a-long-random-string
